{
  "name": "neoground/charm",
  "description": "Charm Framework",
  "homepage": "https://neoground.com/en/open-source/charm",
  "license": "MIT",
  "version": "v3.9",
  "authors": [
    {
      "name": "Sarah Robin / Neoground GmbH",
      "homepage": "https://neoground.com"
    }
  ],
  "require": {
    "php": ">=8.4",
    "ext-json": "*",
    "ext-fileinfo": "*",
    "ext-openssl": "*",
    "monolog/monolog": "^3.10",
    "nesbot/carbon": "^3.13",
    "symfony/console": "^8.1",
    "twig/twig": "^3.28",
    "phroute/phroute": "^2.2",
    "predis/predis": "^3.2",
    "symfony/yaml": "^8.1",
    "dragonmantank/cron-expression": "^3.6",
    "phpmailer/phpmailer": "^7.1",
    "league/flysystem": "^3.35",
    "league/flysystem-sftp-v3": "^3.33",
    "opis/closure": "^4.5",
    "claviska/simpleimage": "^4.4",
    "illuminate/database": "^13.25",
    "guzzlehttp/guzzle": "^8.0",
    "respect/validation": "^2.5",
    "filp/whoops": "^2.18",
    "kint-php/kint": "^6.1",
    "php-debugbar/php-debugbar": "^3.8",
    "phpunit/phpunit": "^13.3"
  },
  "suggest": {
    "ext-pcntl": "Required when you want to use the built-in cron daemon",
    "ext-redis": "For native redis support instead of using predis",
    "kint-php/kint-twig": "Provides d() and s() functions in twig templates"
  },
  "autoload": {
    "psr-4": {
      "Charm\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "App\\": "tests/FrameworkApp/app/"
    }
  }
}
